# ---------- Core ----------
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://wallpaper:wallpaper@localhost:5432/wallpaper_ai"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
APP_URL=http://localhost:5173

# ---------- Google sign-in ----------
GOOGLE_CLIENT_ID=

# ---------- AI providers (leave empty to use a mock) ----------
# Free tier: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FREE_DAILY_LIMIT=50
# Premium tier: OpenRouter (takes priority) or Gemini directly
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
GEMINI_API_KEY=

# ---------- File storage (leave empty to use the local ./storage folder) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- Payments: Creem (Merchant of Record) ----------
# sandbox = test keys (creem_test_...), production = live keys (creem_...)
CREEM_MODE=sandbox
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_STARTER=
CREEM_PRODUCT_POPULAR=
CREEM_PRODUCT_PRO=