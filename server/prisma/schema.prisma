
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId        String?  @unique
  credits         Int      @default(0)
  freeGenerations Int      @default(2)
  createdAt    DateTime @default(now())
  generations Generation[]
  payments    Payment[]
}

enum GenerationStatus {
  PENDING
  DONE
  FAILED
}

enum GenerationTier {
  FREE
  PREMIUM
}

model Generation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  styleId     String
  originalKey String
  resultKey   String?
  status      GenerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  tier        GenerationTier   @default(PREMIUM)
  steps       Json?
  prompt      String?
  analysis    Json?
  reviews     Json?
  step        String?

  @@index([userId, createdAt])
}
model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  providerOrderId String   @unique
  packId          String
  credits         Int
  amount          Int
  currency        String
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}
